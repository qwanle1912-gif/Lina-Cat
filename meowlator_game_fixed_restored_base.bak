<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>MeowLator - Căn Phòng Mèo Của Lina & Qwan 💕</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Three.js CDN for 3D graphics -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Google Fonts: Nunito, Inter & Dancing Script for Lina's Rug -->
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Inter:wght@400;600;700;900&family=Nunito:wght@600;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-cream: #fffbf5;
            --border-dark: #271c19;
            --card-bg: rgba(255, 255, 255, 0.96);
        }
        * {
            -webkit-tap-highlight-color: transparent;
            box-sizing: border-box;
        }
        body {
            font-family: 'Nunito', 'Inter', sans-serif;
            background-color: #fcefe3;
            color: var(--border-dark);
            user-select: none;
            overflow: hidden;
            touch-action: manipulation;
        }
        .cozy-card {
            background-color: var(--bg-cream);
            border: 3px solid var(--border-dark);
            box-shadow: 4px 4px 0px var(--border-dark);
            border-radius: 1.25rem;
        }
        .cozy-pill {
            background-color: var(--bg-cream);
            border: 2.5px solid var(--border-dark);
            box-shadow: 0 3px 0 var(--border-dark);
            border-radius: 9999px;
        }
        .cozy-btn {
            border: 2.5px solid var(--border-dark);
            box-shadow: 0 3px 0 var(--border-dark);
            border-radius: 1rem;
            transition: all 0.12s ease;
            cursor: pointer;
        }
        .cozy-btn:hover {
            transform: translateY(-1.5px);
            box-shadow: 0 4.5px 0 var(--border-dark);
        }
        .cozy-btn:active {
            transform: translateY(2px);
            box-shadow: 0 1px 0 var(--border-dark);
        }
        .stat-bar-track {
            background-color: #e5e7eb;
            border: 2px solid var(--border-dark);
            border-radius: 9999px;
            height: 12px;
            overflow: hidden;
        }
        .stat-bar-fill {
            background: linear-gradient(90deg, #34d399, #10b981);
            height: 100%;
            border-radius: 9999px;
            transition: width 0.35s ease;
        }
        .cozy-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .cozy-scroll::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        #laser-dot {
            position: fixed;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: radial-gradient(circle, #fff 10%, #ff0044 50%, rgba(255,0,68,0) 100%);
            box-shadow: 0 0 14px #ff0044, 0 0 28px #ff0044;
            pointer-events: none;
            z-index: 40;
            display: none;
            transform: translate(-50%, -50%);
        }
        .side-panel-wrapper {
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease;
        }
        .left-collapsed {
            transform: translateX(-120%);
            opacity: 0;
            pointer-events: none !important;
        }
        .right-collapsed {
            transform: translateX(120%);
            opacity: 0;
            pointer-events: none !important;
        }
        .panel-toggle-tab {
            background-color: var(--bg-cream);
            border: 2.5px solid var(--border-dark);
            box-shadow: 0 3px 0 var(--border-dark), 0 4px 12px rgba(0,0,0,0.15);
            color: var(--border-dark);
            cursor: pointer;
        }
        @keyframes floatUpFade {
            0% { opacity: 0; transform: translateY(12px) scale(0.9); }
            15% { opacity: 1; transform: translateY(0px) scale(1); }
            80% { opacity: 1; transform: translateY(-24px) scale(1.02); }
            100% { opacity: 0; transform: translateY(-40px) scale(0.9); }
        }
        .floating-bubble {
            animation: floatUpFade 2.5s forwards cubic-bezier(0.2, 0.8, 0.2, 1);
        }
        .hud-hidden {
            opacity: 0 !important;
            pointer-events: none !important;
            transform: translateY(24px) scale(0.96);
            transition: all 0.25s ease;
        }
        .hud-visible {
            opacity: 1;
            transform: translateY(0) scale(1);
            transition: all 0.25s ease;
        }

        /* PC DESKTOP SCALING: LARGE, CRISP & HIGHLY LEGIBLE HUDS */
        @media (min-width: 768px) {
            .desktop-scale-dock {
                padding: 0.75rem 1.25rem !important;
                gap: 1.25rem !important;
            }
            .desktop-scale-btn {
                padding: 0.5rem 0.75rem !important;
            }
            .desktop-scale-icon {
                width: 3.5rem !important;
                height: 3.5rem !important;
                font-size: 1.75rem !important;
            }
            .desktop-scale-text {
                font-size: 0.875rem !important;
            }
        }
    </style>
</head>
<body class="h-screen w-screen flex flex-col justify-between p-2 sm:p-4 relative select-none overflow-hidden">

    <!-- 3D WebGL Canvas Container -->
    <div id="canvas-container" class="absolute inset-0 z-0"></div>

    <!-- Laser Dot for Playing with Cats -->
    <div id="laser-dot"></div>

    <!-- Confetti Canvas Layer -->
    <canvas id="confetti-canvas" class="absolute inset-0 pointer-events-none z-40"></canvas>

    <!-- FLOATING NOTIFICATION FX CONTAINER -->
    <div id="floating-fx-layer" class="absolute inset-0 pointer-events-none z-30 overflow-hidden flex flex-col items-center justify-start pt-16 sm:pt-20 gap-2"></div>

    <!-- MINIMAL FLOATING HUD RE-OPEN BUTTON -->
    <button id="hud-show-btn" onclick="toggleHUDVisibility()" class="hidden fixed top-3 right-3 z-50 cozy-pill px-4 py-2 bg-amber-100 hover:bg-amber-200 border-2 border-slate-900 shadow-2xl flex items-center gap-2 text-xs sm:text-sm font-black">
        <span class="text-base sm:text-lg">👁️</span><span>Hiện Giao Diện</span>
    </button>

    <!-- TOP BAR: USERS (LINA & QWAN), REAL-TIME HCM WEATHER, COINS, HUD HIDE TOGGLE -->
    <header id="main-header" class="hud-visible relative z-20 w-full flex items-center justify-between gap-2 max-w-7xl mx-auto px-1">
        <!-- Current User Profile & Time/Weather -->
        <div class="flex items-center gap-2">
            <!-- User Login Profile Badge -->
            <button onclick="promptUserLoginSwitch()" class="cozy-pill px-3.5 py-1.5 flex items-center gap-1.5 text-xs sm:text-sm font-black bg-pink-100 hover:bg-pink-200 text-pink-900 shadow-sm" title="Nhấp để chuyển người chơi (Lina / Qwan)">
                <span class="text-sm sm:text-base">💕</span>
                <span id="current-user-name">Lina</span>
                <span class="text-[10px] text-pink-600 bg-white/80 px-1.5 py-0.5 rounded-full border border-pink-300">Đổi</span>
            </button>

            <!-- Real-Time & Weather HCM Badge -->
            <div id="realtime-display" class="cozy-pill px-3.5 py-1.5 flex items-center gap-2 text-xs sm:text-sm font-black shadow-sm">
                <span>☀️</span> <span>32°C TP.HCM</span> • <span>12:00</span>
            </div>

            <!-- Online Sync Status Indicator -->
            <div id="sync-status-badge" class="hidden sm:flex cozy-pill px-2.5 py-1 items-center gap-1.5 text-[11px] font-extrabold text-emerald-700 bg-emerald-50" title="Đồng bộ 2 máy giữa Lina & Qwan">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>2 Máy Nuôi Chung</span>
            </div>
        </div>

        <!-- Right Side: Coins & HUD Toggle -->
        <div class="flex items-center gap-2">
            <div class="cozy-pill px-4 py-1.5 flex items-center gap-2 text-xs sm:text-base font-black bg-amber-50 shadow-sm">
                <span class="text-amber-500 text-base sm:text-lg">🪙</span>
                <span id="coin-count" class="text-amber-700 tracking-wide font-black">1,470</span>
            </div>
            <button onclick="toggleHUDVisibility()" class="cozy-btn p-2 sm:px-3 sm:py-1.5 text-xs sm:text-sm font-black bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center gap-1" title="Ẩn giao diện để ngắm trọn vẹn căn phòng mèo">
                <span>👁️</span><span class="hidden sm:inline">Ẩn Hub</span>
            </button>
        </div>
    </header>

    <!-- MIDDLE AREA: SIDE TABS & CORNER PANELS (WON'T BLOCK THE CAT) -->
    <div id="middle-area" class="hud-visible relative z-20 flex-1 flex items-start justify-between gap-3 my-2 overflow-hidden pointer-events-none">

        <!-- FLOATING REOPEN TAB FOR LEFT PANEL -->
        <button id="left-reopen-tab" onclick="toggleSidePanel('left')" class="panel-toggle-tab fixed left-0 top-1/2 -translate-y-1/2 z-30 rounded-r-2xl border-l-0 px-3 py-3 flex flex-col items-center gap-1 pointer-events-auto shadow-md" title="Mở bảng Chỉ số">
            <span class="text-lg">🐾</span>
            <span class="text-xs font-black [writing-mode:vertical-lr]">Chỉ số</span>
            <span class="text-xs font-black text-slate-500">▶</span>
        </button>

        <!-- LEFT PANEL: Room Status -->
        <div id="left-panel-card" class="side-panel-wrapper left-collapsed cozy-card w-64 sm:w-72 max-h-[78vh] flex flex-col p-4 pointer-events-auto overflow-y-auto cozy-scroll relative shadow-2xl">
            <div class="flex items-start justify-between border-b-2 border-slate-200 pb-2.5 gap-1">
                <div class="min-w-0">
                    <div class="flex items-center gap-1">
                        <span id="room-name-display" onclick="renameRoomPrompt()" class="font-black text-sm sm:text-base cursor-pointer hover:underline truncate" title="Đổi tên phòng">Phòng Mèo Của Vợ</span>
                        <button onclick="renameRoomPrompt()" class="text-xs text-slate-400">✏️</button>
                    </div>
                    <div id="room-sub-info" class="text-xs font-bold text-slate-500">1 bé mèo cưng</div>
                </div>
                <button onclick="toggleSidePanel('left')" class="cozy-btn px-2.5 py-1 text-xs font-black bg-amber-100">◀ Ẩn</button>
            </div>

            <div class="mt-3 space-y-2.5 text-xs sm:text-sm font-extrabold">
                <div>
                    <div class="flex justify-between items-center text-xs mb-1">
                        <span>🥫 No bụng phòng</span>
                        <span id="stat-hunger-val" class="text-emerald-600 font-black">90%</span>
                    </div>
                    <div class="stat-bar-track"><div id="stat-hunger-bar" class="stat-bar-fill" style="width: 90%"></div></div>
                </div>
                <div>
                    <div class="flex justify-between items-center text-xs mb-1">
                        <span>🐱 Mèo thư thái</span>
                        <span id="stat-happy-val" class="text-emerald-600 font-black">88%</span>
                    </div>
                    <div class="stat-bar-track"><div id="stat-happy-bar" class="stat-bar-fill" style="width: 88%"></div></div>
                </div>
                <div>
                    <div class="flex justify-between items-center text-xs mb-1">
                        <span>✨ Sạch sẽ</span>
                        <span id="stat-clean-val" class="text-emerald-600 font-black">100%</span>
                    </div>
                    <div class="stat-bar-track"><div id="stat-clean-bar" class="stat-bar-fill" style="width: 100%"></div></div>
                </div>
            </div>

            <div class="mt-3 pt-2.5 border-t-2 border-slate-200 text-xs font-bold text-slate-600 space-y-1">
                <div class="flex justify-between items-center">
                    <span>ĐIỂM PHÒNG: <strong class="text-slate-800 text-sm">88/100</strong></span>
                    <span class="text-amber-600 font-black">≈ 120🪙/NGÀY</span>
                </div>
                <div class="text-[11px] text-pink-600 italic">Thảm nhung ghi tên Lina 💕</div>
            </div>
        </div>

        <!-- RIGHT SIDE: REOPEN TAB & QUEST CARD -->
        <button id="right-reopen-tab" onclick="toggleSidePanel('right')" class="panel-toggle-tab fixed right-0 top-1/2 -translate-y-1/2 z-30 rounded-l-2xl border-r-0 px-3 py-3 flex flex-col items-center gap-1 pointer-events-auto shadow-md" title="Mở Nhiệm vụ">
            <span class="text-lg">✨</span>
            <span class="text-xs font-black [writing-mode:vertical-lr]">Nhiệm vụ</span>
            <span class="text-xs font-black text-slate-500">◀</span>
        </button>

        <div id="right-panel-card" class="side-panel-wrapper right-collapsed cozy-card w-64 sm:w-72 max-h-[78vh] flex flex-col p-4 pointer-events-auto overflow-y-auto cozy-scroll relative shadow-2xl">
            <div class="flex items-center justify-between border-b-2 border-slate-200 pb-2.5">
                <div class="font-black text-sm sm:text-base flex items-center gap-1.5"><span>✨</span><span>Mục tiêu nuôi mèo</span></div>
                <button onclick="toggleSidePanel('right')" class="cozy-btn px-2.5 py-1 text-xs font-black bg-amber-100">Ẩn ▶</button>
            </div>
            <div class="mt-3 text-xs sm:text-sm space-y-1.5">
                <div id="main-quest-step" class="text-[11px] font-black text-slate-400 uppercase">NHIỆM VỤ 1/5</div>
                <div id="main-quest-title" class="font-black text-sm text-slate-800">Nuôi Boss Lớn Lên</div>
                <div id="main-quest-desc" class="text-xs font-bold text-slate-600">Nuôi dưỡng bé mèo đạt Cấp 2 (Mới Lớn)</div>
                <div class="flex items-center gap-2 mt-2">
                    <div class="flex-1 stat-bar-track"><div id="main-quest-bar" class="stat-bar-fill" style="width: 20%"></div></div>
                    <span id="main-quest-prog" class="text-xs font-black">1/2</span>
                    <span id="main-quest-reward" class="text-xs font-black text-amber-600">🪙150</span>
                </div>
                <button id="claim-main-quest-btn" onclick="claimMainQuest()" class="hidden w-full mt-2 cozy-btn py-2 bg-emerald-400 text-white font-black text-xs shadow-md">
                    🎁 Nhận thưởng nhiệm vụ!
                </button>
            </div>
        </div>

        <!-- CAT INSPECTOR POPUP (COMPACT AT TOP-RIGHT, NEVER BLOCKS THE 3D CAT IN CENTER) -->
        <div id="cat-inspector" class="hidden fixed top-16 right-3 sm:right-6 z-30 cozy-card p-3.5 sm:p-4 w-72 sm:w-80 pointer-events-auto shadow-2xl bg-[#fffbf5]/95 backdrop-blur-md">
            <div class="flex justify-between items-start mb-2">
                <div class="flex items-center gap-2">
                    <span id="insp-emoji" class="text-2xl sm:text-3xl">🐱</span>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span id="insp-name" class="font-black text-sm sm:text-base">Miu Cam</span>
                            <button onclick="renameSelectedCat()" class="text-xs text-slate-400 hover:text-slate-700">✏️</button>
                        </div>
                        <div id="insp-breed" class="text-xs font-bold text-slate-500">Mèo Cam Mướp</div>
                    </div>
                </div>
                <button onclick="closeInspector()" class="text-xs font-black px-2 py-0.5 rounded bg-slate-200 hover:bg-slate-300">✕</button>
            </div>

            <!-- LEVEL & TIME-BASED GROWTH PROGRESS -->
            <div class="mb-2.5 p-2.5 bg-gradient-to-r from-pink-50 to-amber-50 rounded-2xl border border-pink-200">
                <div class="flex items-center justify-between text-xs">
                    <span id="insp-level-badge" class="px-2.5 py-0.5 rounded-full bg-pink-500 text-white font-black text-xs shadow-sm">🍼 Cấp 1: Bé Con</span>
                    <span id="insp-growth-val" class="font-black text-pink-600">Lớn: 20%</span>
                </div>
                <div class="stat-bar-track mt-1.5 bg-pink-100">
                    <div id="insp-growth-bar" class="stat-bar-fill bg-gradient-to-r from-pink-400 to-amber-400" style="width: 20%"></div>
                </div>
                <div id="insp-growth-hint" class="text-[11px] font-bold text-slate-500 mt-1 flex justify-between">
                    <span>Lớn tự nhiên (~10h lên Cấp 3)</span>
                    <span class="text-emerald-600 font-black">Đang online trông nom</span>
                </div>
            </div>

            <!-- STATS -->
            <div class="text-xs font-bold space-y-1 mb-2.5 bg-amber-50/80 p-2 rounded-xl border border-slate-300">
                <div class="flex justify-between"><span>No bụng:</span><span id="insp-hunger" class="text-emerald-600 font-extrabold">90%</span></div>
                <div class="flex justify-between"><span>Thân thiết:</span><span id="insp-love" class="text-rose-500 font-extrabold">85% 💕</span></div>
                <div class="flex justify-between"><span>Phụ kiện:</span><span id="insp-hat" class="text-amber-600 font-extrabold">Chuông Vàng</span></div>
            </div>

            <!-- QUICK CARE BUTTONS (WITH COOLDOWNS & LIMITS) -->
            <div class="grid grid-cols-4 gap-1.5">
                <button onclick="petSelectedCat()" id="btn-pet-action" class="cozy-btn py-1.5 text-xs font-black bg-pink-100 hover:bg-pink-200">👋 Vuốt</button>
                <button onclick="openFeedingModal()" class="cozy-btn py-1.5 text-xs font-black bg-amber-100 hover:bg-amber-200">🥫 Ăn</button>
                <button onclick="actionBrush()" id="btn-brush-action" class="cozy-btn py-1.5 text-xs font-black bg-teal-100 hover:bg-teal-200">🪮 Chải</button>
                <button onclick="cycleSelectedCatAccessory()" class="cozy-btn py-1.5 text-xs font-black bg-purple-100 hover:bg-purple-200">🎀 Mũ</button>
            </div>

            <!-- ON-DEMAND EMOTE COMMAND BAR -->
            <div class="mt-2.5 pt-2 border-t border-slate-200">
                <div class="text-[10px] font-black uppercase text-slate-400 mb-1">LỆNH CHO MÈO LÀM THEO:</div>
                <div class="grid grid-cols-3 gap-1 text-[11px] font-black">
                    <button onclick="commandCatEmote('sleep')" class="cozy-btn py-1 bg-indigo-50 hover:bg-indigo-100">😴 Đi ngủ</button>
                    <button onclick="commandCatEmote('wheel')" class="cozy-btn py-1 bg-cyan-50 hover:bg-cyan-100">🏃 Bánh xe</button>
                    <button onclick="commandCatEmote('tree')" class="cozy-btn py-1 bg-amber-50 hover:bg-amber-100">🌳 Leo tháp</button>
                    <button onclick="commandCatEmote('box')" class="cozy-btn py-1 bg-orange-50 hover:bg-orange-100">📦 Chui hộp</button>
                    <button onclick="commandCatEmote('flip')" class="cozy-btn py-1 bg-pink-50 hover:bg-pink-100">🤸 Nhào lộn</button>
                    <button onclick="commandCatEmote('come')" class="cozy-btn py-1 bg-emerald-50 hover:bg-emerald-100">🐾 Lại đây</button>
                </div>
            </div>
        </div>
    </div>

    <!-- DECOR EDIT MODE OVERLAY -->
    <div id="decor-edit-banner" class="hidden fixed top-14 left-1/2 -translate-x-1/2 z-40 cozy-pill px-4 py-1.5 bg-amber-100/95 border-2 border-slate-900 shadow-2xl flex items-center gap-2 max-w-[95vw]">
        <span class="text-base sm:text-lg">🛠️</span>
        <span class="text-xs sm:text-sm font-black text-slate-800 truncate">Sắp Đặt Phòng: Kéo chuột trên sàn hoặc bấm nút để chuyển đồ</span>
        <button onclick="exitDecorEditMode()" class="cozy-btn px-3 py-1 text-xs font-black bg-emerald-400 text-white shrink-0">Xong</button>
    </div>

    <div id="decor-edit-widget" class="hidden fixed bottom-24 left-1/2 -translate-x-1/2 z-40 cozy-card p-2.5 sm:p-3 flex flex-wrap items-center justify-center gap-2 shadow-2xl bg-[#fffbf5] border-2 border-slate-900 max-w-[96vw]">
        <div class="flex items-center gap-1.5">
            <span class="text-xs font-black text-slate-500">Chọn đồ:</span>
            <select id="decor-picker-select" onchange="onDecorSelectChanged()" class="cozy-pill px-2.5 py-1 text-xs font-black bg-white">
            </select>
        </div>
        <div class="flex items-center gap-1">
            <button onclick="nudgeSelectedDecor(-0.35, 0)" class="cozy-btn px-2.5 py-1 text-xs font-black bg-amber-100">⬅️ Trái</button>
            <button onclick="nudgeSelectedDecor(0.35, 0)" class="cozy-btn px-2.5 py-1 text-xs font-black bg-amber-100">➡️ Phải</button>
            <button onclick="nudgeSelectedDecor(0, -0.35)" class="cozy-btn px-2.5 py-1 text-xs font-black bg-amber-100">⬆️ Sâu</button>
            <button onclick="nudgeSelectedDecor(0, 0.35)" class="cozy-btn px-2.5 py-1 text-xs font-black bg-amber-100">⬇️ Trước</button>
            <button onclick="rotateSelectedDecor()" class="cozy-btn px-2.5 py-1 text-xs font-black bg-purple-100">🔄 Xoay</button>
            <button onclick="toggleSelectedDecorActive()" id="decor-toggle-btn" class="cozy-btn px-2.5 py-1 text-xs font-black bg-rose-100">📦 Cất</button>
        </div>
        <button onclick="exitDecorEditMode()" class="cozy-btn px-3.5 py-1.5 text-xs font-black bg-emerald-400 text-white">
            ✅ Hoàn tất
        </button>
    </div>

    <!-- STREAMLINED BOTTOM DOCK (SCALED LARGER FOR PC DESKTOP USERS) -->
    <footer id="main-footer" class="hud-visible relative z-20 w-full max-w-5xl mx-auto flex items-center justify-center gap-2 px-1 pb-1">
        <div class="cozy-card px-2.5 sm:px-4 py-2 sm:py-2.5 flex items-center justify-between gap-1.5 sm:gap-4 w-full overflow-x-auto cozy-scroll shadow-xl desktop-scale-dock">
            <!-- 1. Cho ăn -->
            <button onclick="openFeedingModal()" class="desktop-scale-btn flex flex-col items-center gap-1 group relative shrink-0" title="Cho mèo ăn">
                <div class="desktop-scale-icon w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-amber-100 border-2 border-slate-900 flex items-center justify-center text-lg sm:text-xl group-hover:scale-105 shadow-sm">🥫</div>
                <span class="desktop-scale-text text-[10px] sm:text-xs font-black">Cho ăn</span>
                <span id="badge-food" class="absolute -top-1 -right-1 w-5 h-5 bg-rose-500 text-white text-[10px] font-black rounded-full border border-slate-900 flex items-center justify-center">19</span>
            </button>

            <!-- 2. Dọn cát -->
            <button onclick="openLitterModal()" class="desktop-scale-btn flex flex-col items-center gap-1 group relative shrink-0" title="Dọn chậu cát">
                <div class="desktop-scale-icon w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-cyan-100 border-2 border-slate-900 flex items-center justify-center text-lg sm:text-xl group-hover:scale-105 shadow-sm">🧹</div>
                <span class="desktop-scale-text text-[10px] sm:text-xs font-black">Dọn cát</span>
            </button>

            <!-- 3. Chải lông -->
            <button onclick="actionBrush()" class="desktop-scale-btn flex flex-col items-center gap-1 group relative shrink-0" title="Chải lông thư giãn">
                <div class="desktop-scale-icon w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-pink-100 border-2 border-slate-900 flex items-center justify-center text-lg sm:text-xl group-hover:scale-105 shadow-sm">🪮</div>
                <span class="desktop-scale-text text-[10px] sm:text-xs font-black">Chải lông</span>
            </button>

            <!-- 4. Đèn laser -->
            <button onclick="toggleLaserPointer()" id="laser-action-btn" class="desktop-scale-btn flex flex-col items-center gap-1 group relative shrink-0" title="Chơi đèn laser">
                <div class="desktop-scale-icon w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-rose-100 border-2 border-slate-900 flex items-center justify-center text-lg sm:text-xl group-hover:scale-105 shadow-sm">🔴</div>
                <span class="desktop-scale-text text-[10px] sm:text-xs font-black">Tia laser</span>
            </button>

            <div class="w-[2px] h-9 bg-slate-300 shrink-0 mx-1"></div>

            <!-- 5. Bày trí & Sơn phòng -->
            <button onclick="openModal('decor-modal')" class="desktop-scale-btn flex flex-col items-center gap-1 group shrink-0" title="Sắp đặt đồ & sơn phòng">
                <div class="desktop-scale-icon w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-violet-100 border-2 border-slate-900 flex items-center justify-center text-lg sm:text-xl group-hover:scale-105 shadow-sm">🪑</div>
                <span class="desktop-scale-text text-[10px] sm:text-xs font-black">Bày trí</span>
            </button>

            <!-- 6. Đàn mèo -->
            <button onclick="openModal('breed-modal')" class="desktop-scale-btn flex flex-col items-center gap-1 group shrink-0" title="Xem danh sách mèo">
                <div class="desktop-scale-icon w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-amber-100 border-2 border-slate-900 flex items-center justify-center text-lg sm:text-xl group-hover:scale-105 shadow-sm">🐱</div>
                <span class="desktop-scale-text text-[10px] sm:text-xs font-black">Đàn mèo</span>
            </button>

            <!-- 7. Ghép đôi -->
            <button onclick="openModal('couple-modal')" class="desktop-scale-btn flex flex-col items-center gap-1 group shrink-0" title="Ghép đôi sinh con">
                <div class="desktop-scale-icon w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-pink-100 border-2 border-slate-900 flex items-center justify-center text-lg sm:text-xl group-hover:scale-105 shadow-sm">💕</div>
                <span class="desktop-scale-text text-[10px] sm:text-xs font-black">Ghép đôi</span>
            </button>

            <div class="w-[2px] h-9 bg-slate-300 shrink-0 mx-1"></div>

            <!-- 8. Kho đồ -->
            <button onclick="openModal('inventory-modal')" class="desktop-scale-btn flex flex-col items-center gap-1 group shrink-0" title="Kho phụ kiện">
                <div class="desktop-scale-icon w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-amber-100 border-2 border-slate-900 flex items-center justify-center text-lg sm:text-xl group-hover:scale-105 shadow-sm">📦</div>
                <span class="desktop-scale-text text-[10px] sm:text-xs font-black">Kho đồ</span>
            </button>

            <!-- 9. Cửa hàng -->
            <button onclick="openModal('shop-modal')" class="desktop-scale-btn flex flex-col items-center gap-1 group shrink-0" title="Cửa hàng mèo & đồ">
                <div class="desktop-scale-icon w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-emerald-100 border-2 border-slate-900 flex items-center justify-center text-lg sm:text-xl group-hover:scale-105 shadow-sm">🛍️</div>
                <span class="desktop-scale-text text-[10px] sm:text-xs font-black">Cửa hàng</span>
            </button>
        </div>
    </footer>

    <!-- MODAL 0: LOGIN & USER PROFILE SELECTION (LINA OR QWAN) -->
    <div id="login-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-md flex items-center justify-center p-4">
        <div class="cozy-card w-full max-w-sm p-6 bg-[#fffbf5] text-center space-y-4 shadow-2xl border-4 border-pink-400">
            <div class="text-4xl animate-bounce">🐱💕</div>
            <h2 class="text-xl font-black text-slate-800">Căn Phòng Mèo Của Vợ Chồng Mình</h2>
            <p class="text-xs font-bold text-slate-600">
                Hãy chọn đúng tên để vào phòng và cùng nuôi mèo nhé!
            </p>
            <div class="grid grid-cols-2 gap-3 pt-2">
                <button onclick="selectUserLogin('Lina')" class="cozy-btn py-3 bg-pink-200 hover:bg-pink-300 flex flex-col items-center gap-1">
                    <span class="text-2xl">👸</span>
                    <span class="font-black text-sm text-pink-900">Lina (Vợ)</span>
                </button>
                <button onclick="selectUserLogin('Qwan')" class="cozy-btn py-3 bg-indigo-200 hover:bg-indigo-300 flex flex-col items-center gap-1">
                    <span class="text-2xl">🤴</span>
                    <span class="font-black text-sm text-indigo-900">Qwan (Chồng)</span>
                </button>
            </div>
            <div class="text-[11px] font-bold text-slate-400">Dữ liệu được đồng bộ để cả 2 người nuôi chung trên 2 máy!</div>
        </div>
    </div>

    <!-- MODAL 1: FEEDING WITH REALISTIC LIMIT & EXPANDED MENU -->
    <div id="feeding-modal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-3">
        <div class="cozy-card w-full max-w-md flex flex-col p-4 sm:p-5 bg-[#fffbf5]">
            <div class="flex justify-between items-center pb-2.5 border-b border-slate-200">
                <div class="flex items-center gap-2"><span class="text-xl">🥫</span><h3 class="font-black text-base sm:text-lg">Thực Đơn Bữa Ăn Mèo Cưng</h3></div>
                <button onclick="closeModal('feeding-modal')" class="cozy-btn px-2.5 py-0.5 font-black bg-slate-200">✕</button>
            </div>
            <div class="py-3 space-y-2.5 max-h-[60vh] overflow-y-auto cozy-scroll">
                <div class="p-2.5 bg-amber-50 rounded-2xl border-2 border-slate-900 flex items-center justify-between">
                    <div>
                        <div class="font-black text-[10px] text-slate-500 uppercase">Máy ăn tự động 2-in-1</div>
                        <div id="bowl-status-txt" class="font-black text-xs sm:text-sm text-amber-800">Thức ăn: 0% • Nước sạch: 100%</div>
                    </div>
                    <div class="text-2xl">🍲</div>
                </div>

                <div class="text-[11px] font-extrabold text-slate-500 uppercase">Quy định: Mèo chỉ ăn khi đói dưới 75%!</div>

                <!-- 1. Hạt khô & thịt sấy -->
                <div class="p-2.5 bg-white rounded-2xl border-2 border-slate-900 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <span class="text-2xl">🥣</span>
                        <div>
                            <div class="font-black text-xs">Hạt Hữu Cơ & Thịt Sấy Thơm Giòn</div>
                            <div class="text-[10px] font-bold text-slate-500">+25% No bụng • Giúp mèo lớn dần</div>
                            <div class="text-[10px] font-black text-amber-600">Kho: <span id="feed-stock-kibble">19</span> gói</div>
                        </div>
                    </div>
                    <button onclick="feedFoodToBowl('kibble')" class="cozy-btn px-3 py-1.5 text-xs font-black bg-emerald-400 text-white">Đổ hạt</button>
                </div>

                <!-- 2. Pate cá ngừ -->
                <div class="p-2.5 bg-white rounded-2xl border-2 border-slate-900 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <span class="text-2xl">🥫</span>
                        <div>
                            <div class="font-black text-xs">Pate Cá Ngừ Hoàng Gia</div>
                            <div class="text-[10px] font-bold text-slate-500">+45% No • Thơm lừng béo ngậy • 25🪙</div>
                        </div>
                    </div>
                    <button onclick="feedFoodToBowl('pate')" class="cozy-btn px-3 py-1.5 text-xs font-black bg-amber-300">Mua & Đổ</button>
                </div>

                <!-- 3. Thịt bò hầm -->
                <div class="p-2.5 bg-white rounded-2xl border-2 border-slate-900 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <span class="text-2xl">🥩</span>
                        <div>
                            <div class="font-black text-xs">Bò Kobe Xé Sợi Hấp Sốt</div>
                            <div class="text-[10px] font-bold text-slate-500">+50% No • Đậm đà dinh dưỡng • 35🪙</div>
                        </div>
                    </div>
                    <button onclick="feedFoodToBowl('beef')" class="cozy-btn px-3 py-1.5 text-xs font-black bg-rose-300">Thưởng bò</button>
                </div>

                <!-- 4. Kem súp thưởng Ciao Churu -->
                <div class="p-2.5 bg-white rounded-2xl border-2 border-slate-900 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <span class="text-2xl">🍦</span>
                        <div>
                            <div class="font-black text-xs">Kem Súp Thưởng Ciao Churu</div>
                            <div class="text-[10px] font-bold text-slate-500">+20% No • +25 Thân thiết • 20🪙</div>
                        </div>
                    </div>
                    <button onclick="feedFoodToBowl('churu')" class="cozy-btn px-3 py-1.5 text-xs font-black bg-pink-300">Đút kem</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL 2: LITTER CLEANING -->
    <div id="litter-modal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-3">
        <div class="cozy-card w-full max-w-sm flex flex-col p-4 sm:p-5 bg-[#fffbf5] text-center space-y-3">
            <div class="flex justify-between items-center pb-2 border-b border-slate-200">
                <div class="flex items-center gap-2"><span class="text-xl">🧹</span><h3 class="font-black text-base">Chậu Cát Vệ Sinh 2 Màu Xám-Kem</h3></div>
                <button onclick="closeModal('litter-modal')" class="cozy-btn px-2.5 py-0.5 font-black bg-slate-200">✕</button>
            </div>
            <div class="text-4xl">🛁</div>
            <div class="bg-cyan-50 p-3 rounded-2xl border-2 border-slate-900 text-xs font-extrabold">
                <div id="litter-clean-txt" class="text-sm font-black text-cyan-800">Cát Sạch: 100%</div>
                <div class="stat-bar-track mt-1.5"><div id="litter-clean-bar" class="stat-bar-fill bg-cyan-500" style="width: 100%"></div></div>
            </div>
            <p class="text-xs font-bold text-slate-600">Thành chậu cao chống văng cát, bậc lưới lọc chân giữ sạch phòng. Giữ chậu luôn sạch giúp mèo sảng khoái và phát triển đều đặn!</p>
            <button onclick="executeCleanLitter()" class="w-full cozy-btn py-2.5 bg-cyan-400 hover:bg-cyan-500 text-white font-black text-xs shadow-sm">
                ✨ Dọn Xúc Cát Bẩn & Thay Cát Thơm Mới
            </button>
        </div>
    </div>

    <!-- MODAL 3: SHOP (CATS, EXPANDED DECOR, FOOD) -->
    <div id="shop-modal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-3">
        <div class="cozy-card w-full max-w-2xl max-h-[85vh] flex flex-col p-4 sm:p-5 bg-[#fffbf5]">
            <div class="flex justify-between items-center pb-2.5 border-b border-slate-200">
                <div class="flex items-center gap-2"><span class="text-xl">🛍️</span><h3 class="font-black text-base sm:text-lg">Cửa Hàng Thú Cưng & Đồ Cho Mèo</h3></div>
                <button onclick="closeModal('shop-modal')" class="cozy-btn px-2.5 py-0.5 font-black bg-slate-200">✕</button>
            </div>
            <div id="shop-tabs" class="flex gap-2 my-2.5 pb-1 border-b border-slate-200">
                <button onclick="switchShopTab('cats')" id="shop-tab-cats" class="cozy-btn px-3 py-1 text-xs font-extrabold bg-amber-200">Mèo Cưng 🐱</button>
                <button onclick="switchShopTab('decor')" id="shop-tab-decor" class="cozy-btn px-3 py-1 text-xs font-extrabold bg-slate-100">Đồ Cho Mèo 🪑</button>
                <button onclick="switchShopTab('food')" id="shop-tab-food" class="cozy-btn px-3 py-1 text-xs font-extrabold bg-slate-100">Thức Ăn 🥫</button>
            </div>
            <div id="shop-content-area" class="flex-1 overflow-y-auto cozy-scroll py-2 grid grid-cols-1 sm:grid-cols-2 gap-2.5"></div>
        </div>
    </div>

    <!-- MODAL 4: CATS ROSTER & NEIGHBOR GIFTING FEATURE -->
    <div id="breed-modal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-3">
        <div class="cozy-card w-full max-w-lg max-h-[85vh] flex flex-col p-4 sm:p-5 bg-[#fffbf5]">
            <div class="flex justify-between items-center pb-2 border-b border-slate-200">
                <div class="flex items-center gap-2"><span class="text-xl">🐱</span><h3 class="font-black text-base sm:text-lg">Đàn Mèo Của Bạn</h3></div>
                <button onclick="closeModal('breed-modal')" class="cozy-btn px-2.5 py-0.5 font-black bg-slate-200">✕</button>
            </div>
            <div class="py-1.5 text-xs font-bold text-slate-500 border-b border-slate-200 flex justify-between items-center">
                <span>Cần ~10 tiếng trông nom để đạt Cấp 3 Trưởng Thành</span>
                <span class="text-pink-600 font-extrabold">Có trên 3 mèo: Tặng hàng xóm (+250🪙)</span>
            </div>
            <div id="cats-roster-list" class="flex-1 overflow-y-auto cozy-scroll py-2.5 space-y-2.5"></div>
        </div>
    </div>

    <!-- MODAL 5: DECOR & ROOM STYLING (WALLS, FLOOR, CURTAINS) -->
    <div id="decor-modal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-3">
        <div class="cozy-card w-full max-w-xl max-h-[85vh] flex flex-col p-4 sm:p-5 bg-[#fffbf5]">
            <div class="flex justify-between items-center pb-2 border-b border-slate-200">
                <div class="flex items-center gap-2"><span class="text-xl">🪑</span><h3 class="font-black text-base sm:text-lg">Bày Trí Phòng & Sơn Tường</h3></div>
                <button onclick="closeModal('decor-modal')" class="cozy-btn px-2.5 py-0.5 font-black bg-slate-200">✕</button>
            </div>
            <div class="flex gap-2 my-2 pb-1 border-b border-slate-200 text-xs">
                <button onclick="switchDecorTab('items')" id="dec-tab-items" class="cozy-btn px-3 py-1 font-black bg-amber-200">Nội Thất & Đồ Chơi</button>
                <button onclick="switchDecorTab('styles')" id="dec-tab-styles" class="cozy-btn px-3 py-1 font-black bg-slate-100">Sơn Tường & Phong Cách</button>
            </div>

            <!-- Tab 1: Items List & Placement Button -->
            <div id="decor-items-tab" class="space-y-2 flex-1 overflow-y-auto cozy-scroll">
                <div class="p-2.5 bg-gradient-to-r from-violet-100 to-pink-100 rounded-2xl border-2 border-slate-900 flex items-center justify-between gap-2">
                    <div>
                        <div class="font-black text-xs sm:text-sm text-violet-900">🛠️ Chế Độ Sắp Đặt Phòng Trực Quan</div>
                        <div class="text-[11px] font-bold text-slate-600">Rê chuột trên sàn để di chuyển và xoay vị trí đồ vật!</div>
                    </div>
                    <button onclick="enterDecorEditMode()" class="cozy-btn px-3.5 py-1.5 bg-violet-500 text-white font-black text-xs shrink-0">Bắt đầu ➔</button>
                </div>
                <div id="decor-toggle-list" class="space-y-2"></div>
            </div>

            <!-- Tab 2: Wall, Floor & Curtain Customization -->
            <div id="decor-styles-tab" class="hidden space-y-3 flex-1 overflow-y-auto cozy-scroll py-1 text-xs">
                <div class="p-3 bg-white rounded-2xl border-2 border-slate-900 space-y-2">
                    <div class="font-black text-slate-700">🎨 Màu & Giấy Dán Tường</div>
                    <div class="grid grid-cols-2 gap-2">
                        <button onclick="setRoomWallStyle('stripes')" class="cozy-btn p-2 text-left bg-pink-50">🌸 Kẻ Sọc Hồng Pastel (Mặc định)</button>
                        <button onclick="setRoomWallStyle('cream')" class="cozy-btn p-2 text-left bg-amber-50">🌾 Vàng Be Ấm Cúng</button>
                        <button onclick="setRoomWallStyle('mint')" class="cozy-btn p-2 text-left bg-teal-50">🌿 Xanh Bạc Hà Mát Mẻ</button>
                        <button onclick="setRoomWallStyle('wood')" class="cozy-btn p-2 text-left bg-stone-100">🪵 Phong Cách Gỗ Tự Nhiên</button>
                    </div>
                </div>
                <div class="p-3 bg-white rounded-2xl border-2 border-slate-900 space-y-2">
                    <div class="font-black text-slate-700">🪵 Loại Sàn Gỗ</div>
                    <div class="grid grid-cols-3 gap-2">
                        <button onclick="setRoomFloorStyle('oak')" class="cozy-btn p-2 bg-amber-100 text-center font-bold">Gỗ Sồi Ấm</button>
                        <button onclick="setRoomFloorStyle('white_wood')" class="cozy-btn p-2 bg-slate-100 text-center font-bold">Gỗ Trắng Bắc Âu</button>
                        <button onclick="setRoomFloorStyle('walnut')" class="cozy-btn p-2 bg-stone-200 text-center font-bold">Gỗ Óc Chó Sẫm</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL 6: BREEDING -->
    <div id="couple-modal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-3">
        <div class="cozy-card w-full max-w-md flex flex-col p-4 sm:p-5 bg-[#fffbf5]">
            <div class="flex justify-between items-center pb-2 border-b border-slate-200">
                <div class="flex items-center gap-2"><span class="text-xl">💕</span><h3 class="font-black text-base sm:text-lg">Ghép Đôi Mèo Cưng</h3></div>
