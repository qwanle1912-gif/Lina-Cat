        const MAIN_QUESTS = [
            { title: 'Nuôi Boss Lớn Lên', desc: 'Nuôi dưỡng bé mèo đầu tiên đạt Cấp 2 (Mới Lớn)', check: s => ({ cur: (s.cats[0] && s.cats[0].level >= 2) ? 1 : 0, max: 1 }), reward: 150 },
