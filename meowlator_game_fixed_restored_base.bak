            { id: 'cat_wheel', name: 'Bánh Xe Chạy Bộ Khổng Lồ 🏃', price: 200, type: 'toy', score: 24, desc: 'Bánh xe tập thể dục đường kính lớn cho mèo chạy bộ vòng vòng' },
