    <div id="inventory-modal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-3">
        <div class="cozy-card w-full max-w-md flex flex-col p-4 sm:p-5 bg-[#fffbf5]">
