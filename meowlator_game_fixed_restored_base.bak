        // FRESH INITIAL STATE: 1 CAT, BASIC ESSENTIALS TO DECORATE STEP BY STEP
        let state = {
            coins: 1470,
            roomName: 'Phòng Mèo Của Vợ',
            gameSpeed: 1,
            lampMode: 'on',
            nightMode: false,
            leftPanelOpen: false,
            rightPanelOpen: false,
            hunger: 70, // Ready to eat
            happiness: 85,
