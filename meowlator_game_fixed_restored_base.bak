    <!-- MODAL 8: LEVEL UP -->
    <div id="levelup-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="cozy-card w-full max-w-sm p-5 bg-[#fffbf5] text-center space-y-2.5 shadow-2xl border-4 border-amber-400">
            <div class="text-4xl animate-bounce">🎉✨</div>
            <h2 class="text-xl font-black text-pink-600">BÉ MÈO ĐÃ LỚN LÊN!</h2>
            <div id="levelup-cat-name" class="text-base font-black text-slate-800">Miu Cam</div>
            <div id="levelup-badge-new" class="inline-block px-3 py-1 rounded-full bg-pink-500 text-white font-black text-xs shadow-md">
