<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MeowLator - Căn Phòng Mèo Của Vợ</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Three.js CDN for 3D graphics -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Google Fonts: Nunito & Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&family=Nunito:wght@600;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-cream: #fffbf5;
            --border-dark: #271c19;
            --card-bg: rgba(255, 255, 255, 0.92);
        }
        body {
            font-family: 'Nunito', 'Inter', sans-serif;
            background-color: #fcefe3;
            color: var(--border-dark);
            user-select: none;
            overflow: hidden;
        }
        .cozy-card {
            background-color: var(--bg-cream);
            border: 3px solid var(--border-dark);
            box-shadow: 4px 4px 0px var(--border-dark);
            border-radius: 1.25rem;
        }
        .cozy-pill {
            background-color: var(--bg-cream);
            border: 2.5px solid var(--border-dark);
            box-shadow: 0 3px 0 var(--border-dark);
            border-radius: 9999px;
        }
        .cozy-btn {
            border: 2.5px solid var(--border-dark);
            box-shadow: 0 3px 0 var(--border-dark);
            border-radius: 1rem;
            transition: all 0.1s ease;
            cursor: pointer;
        }
        .cozy-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 0 var(--border-dark);
        }
        .cozy-btn:active {
            transform: translateY(2px);
            box-shadow: 0 1px 0 var(--border-dark);
        }
        .stat-bar-track {
            background-color: #e5e7eb;
            border: 2px solid var(--border-dark);
            border-radius: 9999px;
            height: 12px;
            overflow: hidden;
        }
        .stat-bar-fill {
            background: linear-gradient(90deg, #34d399, #10b981);
            height: 100%;
            border-radius: 9999px;
            transition: width 0.4s ease;
        }
        .mini-bar-track {
            background-color: #e5e7eb;
            border: 1.5px solid var(--border-dark);
            border-radius: 9999px;
            height: 8px;
            overflow: hidden;
        }
        .cozy-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .cozy-scroll::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }
        .cozy-scroll::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        #laser-dot {
            position: fixed;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: radial-gradient(circle, #fff 10%, #ff0044 50%, rgba(255,0,68,0) 100%);
            box-shadow: 0 0 12px #ff0044, 0 0 24px #ff0044;
            pointer-events: none;
            z-index: 40;
            display: none;
            transform: translate(-50%, -50%);
        }
        .side-panel-wrapper {
            transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.25s ease;
        }
        .left-collapsed {
            transform: translateX(-115%);
            opacity: 0;
            pointer-events: none !important;
        }
        .right-collapsed {
            transform: translateX(115%);
            opacity: 0;
            pointer-events: none !important;
        }
        .panel-toggle-tab {
            background-color: var(--bg-cream);
            border: 2.5px solid var(--border-dark);
            box-shadow: 0 3px 0 var(--border-dark), 0 6px 14px rgba(0,0,0,0.2);
            color: var(--border-dark);
            transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
            cursor: pointer;
        }
        .panel-toggle-tab:hover {
            background-color: #fff3d1;
            transform: scale(1.04);
        }
    </style>
</head>
<body class="h-screen w-screen flex flex-col justify-between p-2 sm:p-3 relative select-none overflow-hidden">

    <!-- 3D WebGL Canvas Container -->
    <div id="canvas-container" class="absolute inset-0 z-0"></div>

    <!-- Laser Dot for Playing with Cats -->
    <div id="laser-dot"></div>

    <!-- FLOATING FLOATING NOTIFICATION FX CONTAINER -->
    <div id="floating-fx-layer" class="absolute inset-0 pointer-events-none z-30 overflow-hidden"></div>

    <!-- TOP BAR: TIME, LIGHT SWITCH, NIGHT MODE, GAME SPEED, COINS -->
    <header class="relative z-20 w-full flex items-center justify-between gap-2 max-w-7xl mx-auto">
        <!-- Time & Lamp Button -->
        <div class="flex items-center gap-2">
            <div class="cozy-pill px-3.5 py-1.5 flex items-center gap-2 text-xs sm:text-sm font-black">
                <span id="time-icon" class="text-base">☀️</span>
                <span id="time-text">10:30</span>
                <span id="day-text" class="text-slate-500 font-bold text-xs">Ngày 1</span>
            </div>
            <button onclick="toggleLamp()" id="lamp-btn" class="cozy-btn px-3.5 py-1.5 text-xs sm:text-sm font-extrabold bg-amber-100 hover:bg-amber-200 flex items-center gap-1.5">
                <span>💡</span><span id="lamp-text">Đèn bật (tay)</span>
            </button>
            <button onclick="toggleNightMode()" id="night-btn" class="cozy-btn p-2 text-sm bg-indigo-100 hover:bg-indigo-200" title="Chế độ Ngày/Đêm">
                🌙
            </button>
        </div>

        <!-- Time Speed Controls -->
        <div class="hidden sm:flex items-center gap-1 bg-white/80 p-1 border-2 border-slate-900 rounded-xl shadow-sm">
            <button onclick="setGameSpeed(0)" id="spd-0" class="px-2.5 py-1 text-xs font-black rounded-lg hover:bg-amber-100">⏸️</button>
            <button onclick="setGameSpeed(1)" id="spd-1" class="px-2.5 py-1 text-xs font-black rounded-lg bg-amber-200">▶️</button>
            <button onclick="setGameSpeed(3)" id="spd-3" class="px-2.5 py-1 text-xs font-black rounded-lg hover:bg-amber-100">⏩</button>
        </div>

        <!-- Coin Balance -->
        <div class="cozy-pill px-4 py-1.5 flex items-center gap-2 text-sm sm:text-base font-black bg-amber-50">
            <span class="text-amber-500 text-lg">🪙</span>
            <span id="coin-count" class="text-amber-700 tracking-wide">1,470</span>
        </div>
    </header>

    <!-- TOP-CENTER FLOATING GUEST ORDER BANNER -->
    <div class="relative z-20 w-full flex justify-center -mt-1 pointer-events-none">
        <div id="guest-banner" class="cozy-pill px-4 py-1.5 flex items-center gap-3 pointer-events-auto">
            <span class="text-base">🐱</span>
            <span id="guest-banner-text" class="text-xs font-extrabold">Đơn của Cô Ngọc • <span id="guest-cond-count" class="text-emerald-700">2/4 điều kiện</span></span>
            <button onclick="openModal('orders-modal')" class="cozy-btn px-3 py-1 text-xs font-extrabold bg-amber-100 hover:bg-amber-200">
                Xem đơn khách
            </button>
        </div>
    </div>

    <!-- MIDDLE AREA: LEFT STATUS CARD + CENTER CAT INSPECTOR + RIGHT QUEST CARD -->
    <div class="relative z-20 flex-1 flex items-center justify-between gap-2 my-1 overflow-hidden pointer-events-none">

        <!-- FLOATING REOPEN TAB FOR LEFT PANEL -->
        <button id="left-reopen-tab" onclick="toggleSidePanel('left')" class="hidden panel-toggle-tab fixed left-0 top-1/2 -translate-y-1/2 z-30 rounded-r-2xl border-l-0 px-3 py-3 flex flex-col items-center gap-1.5 pointer-events-auto shadow-xl" title="Mở bảng Chỉ số phòng">
            <span class="text-xl">🐾</span>
            <span class="text-[11px] font-black [writing-mode:vertical-lr]">Chỉ số</span>
            <span id="left-tab-score" class="px-1.5 py-0.5 rounded-full bg-emerald-500 text-white text-[10px] font-black">94★</span>
            <span class="text-xs font-black text-slate-600 mt-0.5">▶</span>
        </button>

        <!-- LEFT PANEL: Room Status & Scoring -->
        <div id="left-panel-card" class="side-panel-wrapper cozy-card w-60 sm:w-64 max-h-full flex flex-col p-3.5 pointer-events-auto overflow-y-auto cozy-scroll relative">
            <div class="flex items-start justify-between border-b-2 border-slate-200 pb-2.5 gap-1">
                <div class="flex items-center gap-1.5 min-w-0">
                    <span class="text-xl shrink-0">🐾</span>
                    <div class="min-w-0">
                        <div class="flex items-center gap-1">
                            <span id="room-name-display" onclick="renameRoomPrompt()" class="font-black text-sm cursor-pointer hover:underline truncate max-w-[100px]" title="Bấm để đổi tên phòng">Phòng Mèo Của Vợ</span>
                            <button onclick="renameRoomPrompt()" class="text-[10px] text-slate-400 hover:text-slate-700 shrink-0">✏️</button>
                        </div>
                        <div id="room-sub-info" class="text-[11px] font-bold text-slate-500 truncate">160 lít • 4 bé mèo</div>
                    </div>
                </div>
                <div class="flex flex-col items-end gap-1 shrink-0">
                    <button onclick="toggleSidePanel('left')" title="Thu gọn bảng trái" class="cozy-btn px-2 py-0.5 text-[10px] font-black bg-amber-100 hover:bg-amber-200 flex items-center gap-0.5">
                        <span>◀</span><span>Ẩn</span>
                    </button>
                    <div id="star-rating" class="text-[11px] tracking-tighter text-amber-400 font-black">⭐⭐⭐⭐☆</div>
                </div>
            </div>

            <!-- NHÌN BẰNG MẮT -->
            <div class="mt-3">
                <div class="text-[10px] font-black tracking-wider text-slate-400 uppercase mb-2">NHÌN BẰNG MẮT</div>
                <div class="mb-2.5">
                    <div class="flex justify-between items-center text-xs font-extrabold mb-1">
                        <span class="flex items-center gap-1.5">🥫 No bụng</span>
                        <span id="stat-hunger-val" class="text-emerald-600">▲12 95</span>
                    </div>
                    <div class="stat-bar-track"><div id="stat-hunger-bar" class="stat-bar-fill" style="width: 95%"></div></div>
                </div>
                <div class="mb-2.5">
                    <div class="flex justify-between items-center text-xs font-extrabold mb-1">
                        <span class="flex items-center gap-1.5">🐱 Mèo thư thái</span>
                        <span id="stat-happy-val" class="text-emerald-600">▲8 88</span>
                    </div>
                    <div class="stat-bar-track"><div id="stat-happy-bar" class="stat-bar-fill" style="width: 88%"></div></div>
                </div>
                <div class="mb-2.5">
                    <div class="flex justify-between items-center text-xs font-extrabold mb-1">
                        <span class="flex items-center gap-1.5">🌿 Cây & Đồ chơi</span>
                        <span id="stat-plant-val" class="text-emerald-600">▲5 80</span>
                    </div>
                    <div class="stat-bar-track"><div id="stat-plant-bar" class="stat-bar-fill" style="width: 80%"></div></div>
                </div>
                <div class="mb-1">
                    <div class="flex justify-between items-center text-xs font-extrabold mb-1">
                        <span class="flex items-center gap-1.5">✨ Sạch cát & Lông</span>
                        <span id="stat-clean-val" class="text-emerald-600">▼2 92</span>
                    </div>
                    <div class="stat-bar-track"><div id="stat-clean-bar" class="stat-bar-fill" style="width: 92%"></div></div>
                </div>
            </div>

            <!-- ĐIỂM PHÒNG -->
            <div class="mt-3 pt-2.5 border-t-2 border-slate-200">
                <div class="flex justify-between items-center mb-2">
                    <span id="total-score-title" class="text-[10px] font-black text-slate-500 uppercase">ĐIỂM PHÒNG 86/100</span>
                    <span id="daily-income-badge" class="text-[11px] font-black text-amber-600">≈ 95 🪙/NGÀY</span>
                </div>
                <div class="space-y-1.5 text-[11px] font-bold">
                    <div class="flex items-center justify-between gap-2">
                        <span class="w-16 text-slate-600">Sức khoẻ</span>
                        <div class="flex-1 mini-bar-track"><div id="sub-health-bar" class="stat-bar-fill" style="width:90%"></div></div>
                        <span id="sub-health-txt" class="w-9 text-right font-extrabold">27/30</span>
                    </div>
                    <div class="flex items-center justify-between gap-2">
                        <span class="w-16 text-slate-600">Cây & Đồ</span>
                        <div class="flex-1 mini-bar-track"><div id="sub-plant-bar" class="stat-bar-fill" style="width:80%"></div></div>
                        <span id="sub-plant-txt" class="w-9 text-right font-extrabold">16/20</span>
                    </div>
                    <div class="flex items-center justify-between gap-2">
                        <span class="w-16 text-slate-600">Đàn mèo</span>
                        <div class="flex-1 mini-bar-track"><div id="sub-cat-bar" class="stat-bar-fill" style="width:85%"></div></div>
                        <span id="sub-cat-txt" class="w-9 text-right font-extrabold">17/20</span>
                    </div>
                    <div class="flex items-center justify-between gap-2">
                        <span class="w-16 text-slate-600">Bày trí</span>
                        <div class="flex-1 mini-bar-track"><div id="sub-decor-bar" class="stat-bar-fill" style="width:93%"></div></div>
                        <span id="sub-decor-txt" class="w-9 text-right font-extrabold">14/15</span>
                    </div>
                    <div class="flex items-center justify-between gap-2">
                        <span class="w-16 text-slate-600">Trình bày</span>
                        <div class="flex-1 mini-bar-track"><div id="sub-style-bar" class="stat-bar-fill" style="width:86%"></div></div>
                        <span id="sub-style-txt" class="w-9 text-right font-extrabold">13/15</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- CENTER FLOATING CAT INSPECTOR -->
        <div id="cat-inspector" class="hidden cozy-card p-3.5 w-68 pointer-events-auto self-end mb-2 mx-auto z-20">
            <div class="flex justify-between items-start mb-2">
                <div class="flex items-center gap-2">
                    <span id="insp-emoji" class="text-2xl">🐱</span>
                    <div>
                        <div class="flex items-center gap-1">
                            <span id="insp-name" class="font-black text-sm">Miu Cam</span>
                            <button onclick="renameSelectedCat()" class="text-xs text-slate-400 hover:text-slate-700" title="Đổi tên mèo">✏️</button>
                        </div>
                        <div id="insp-breed" class="text-[11px] font-bold text-slate-500">Mèo Cam Mướp</div>
                    </div>
                </div>
                <button onclick="closeInspector()" class="text-xs font-black px-1.5 py-0.5 rounded bg-slate-200 hover:bg-slate-300">✕</button>
            </div>
            <div class="text-xs font-bold space-y-1 mb-2.5 bg-amber-50/80 p-2 rounded-xl border border-slate-300">
                <div class="flex justify-between"><span>Trạng thái:</span><span id="insp-state" class="text-pink-600 font-extrabold">Đang dạo chơi</span></div>
                <div class="flex justify-between"><span>No bụng:</span><span id="insp-hunger" class="text-emerald-600 font-extrabold">94%</span></div>
                <div class="flex justify-between"><span>Phụ kiện:</span><span id="insp-hat" class="text-amber-600 font-extrabold">Chuông Vàng</span></div>
            </div>
            <div class="grid grid-cols-3 gap-1.5">
                <button onclick="petSelectedCat()" class="cozy-btn py-1.5 text-[11px] font-extrabold bg-pink-100 hover:bg-pink-200">👋 Vuốt ve</button>
                <button onclick="feedSelectedCatTreat()" class="cozy-btn py-1.5 text-[11px] font-extrabold bg-amber-100 hover:bg-amber-200">🐟 Thưởng</button>
                <button onclick="cycleSelectedCatAccessory()" class="cozy-btn py-1.5 text-[11px] font-extrabold bg-purple-100 hover:bg-purple-200">🎀 Đổi đồ</button>
            </div>
        </div>

        <!-- FLOATING REOPEN TAB FOR RIGHT PANEL -->
        <button id="right-reopen-tab" onclick="toggleSidePanel('right')" class="hidden panel-toggle-tab fixed right-0 top-1/2 -translate-y-1/2 z-30 rounded-l-2xl border-r-0 px-3 py-3 flex flex-col items-center gap-1.5 pointer-events-auto shadow-xl" title="Mở bảng Mục tiêu & Việc hôm nay">
            <span class="text-xl relative">
                ✨
                <span id="right-tab-dot" class="hidden absolute -top-1 -right-1 w-3 h-3 rounded-full bg-rose-500 border border-white animate-ping"></span>
            </span>
            <span class="text-[11px] font-black">Mục tiêu</span>
            <span class="text-xs font-black text-slate-600 mt-0.5">◀</span>
        </button>

        <!-- RIGHT PANEL: Objectives & Daily Checklist -->
        <div id="right-panel-card" class="side-panel-wrapper cozy-card w-60 sm:w-64 max-h-full flex flex-col p-3.5 pointer-events-auto overflow-y-auto cozy-scroll relative">
            <div class="flex items-center justify-between border-b-2 border-slate-200 pb-2.5 gap-1">
                <div class="flex items-center gap-2 min-w-0">
                    <span class="text-lg shrink-0">✨</span>
                    <div class="min-w-0">
                        <div class="font-black text-sm">Mục tiêu</div>
                        <div class="text-[11px] font-bold text-slate-500 truncate">Chương 1 • Con Sen Của Vợ</div>
                    </div>
                </div>
                <button onclick="toggleSidePanel('right')" title="Thu gọn bảng phải" class="cozy-btn px-2 py-0.5 text-[10px] font-black bg-amber-100 hover:bg-amber-200 flex items-center gap-0.5 shrink-0">
                    <span>Ẩn</span><span>▶</span>
                </button>
            </div>
            <div class="mt-3 border-b-2 border-slate-200 pb-3">
                <div id="main-quest-step" class="text-[10px] font-black text-slate-400 uppercase">NHIỆM VỤ 1/8</div>
                <div id="main-quest-title" class="font-black text-sm mt-0.5">Nhà sưu tầm Boss</div>
                <div id="main-quest-desc" class="text-xs font-bold text-slate-600 mt-0.5">Nuôi 5 bé mèo đáng yêu cùng lúc trong phòng</div>
                <div class="flex items-center gap-2 mt-2">
                    <div class="flex-1 stat-bar-track"><div id="main-quest-bar" class="stat-bar-fill" style="width: 60%"></div></div>
                    <span id="main-quest-prog" class="text-xs font-black">3/5</span>
                    <span id="main-quest-reward" class="text-xs font-black text-amber-600">🪙120</span>
                </div>
                <button id="claim-main-quest-btn" onclick="claimMainQuest()" class="hidden w-full mt-2 cozy-btn py-1.5 bg-emerald-400 text-white font-black text-xs">
                    🎁 Nhận thưởng nhiệm vụ!
                </button>
            </div>
            <div class="mt-3">
                <div class="text-[10px] font-black text-slate-400 uppercase mb-2">VIỆC HÔM NAY</div>
                <div id="daily-tasks-list" class="space-y-2.5 text-xs font-bold"></div>
            </div>
        </div>
    </div>

    <!-- BOTTOM DOCK NAVIGATION -->
    <footer class="relative z-20 w-full max-w-7xl mx-auto grid grid-cols-3 gap-2 sm:gap-3">
        <!-- Chăm Sóc Panel Button -->
        <div class="cozy-card p-2 flex items-center justify-around gap-1">
            <button onclick="actionFeed()" class="flex flex-col items-center gap-1 group relative" title="Cho mèo ăn">
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-amber-100 border-2 border-slate-900 flex items-center justify-center text-lg group-hover:scale-110 shadow-sm">🥫</div>
                <span class="text-[10px] sm:text-xs font-extrabold">Cho ăn</span>
                <span id="badge-food" class="absolute -top-1 -right-1 w-5 h-5 bg-rose-500 text-white text-[10px] font-black rounded-full border-2 border-slate-900 flex items-center justify-center">19</span>
            </button>
            <button onclick="actionClean()" class="flex flex-col items-center gap-1 group relative" title="Dọn cát vệ sinh">
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-cyan-100 border-2 border-slate-900 flex items-center justify-center text-lg group-hover:scale-110 shadow-sm">🧹</div>
                <span class="text-[10px] sm:text-xs font-extrabold">Dọn cát</span>
            </button>
            <button onclick="actionBrush()" class="flex flex-col items-center gap-1 group relative" title="Chải lông thư giãn">
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-pink-100 border-2 border-slate-900 flex items-center justify-center text-lg group-hover:scale-110 shadow-sm">🪮</div>
                <span class="text-[10px] sm:text-xs font-extrabold">Chải lông</span>
            </button>
            <button onclick="toggleLaserPointer()" id="laser-action-btn" class="flex flex-col items-center gap-1 group relative" title="Bật đèn Laser chơi đùa">
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-rose-100 border-2 border-slate-900 flex items-center justify-center text-lg group-hover:scale-110 shadow-sm">🔴</div>
                <span class="text-[10px] sm:text-xs font-extrabold">Đèn laser</span>
            </button>
        </div>

        <!-- Phòng Panel Button -->
        <div class="cozy-card p-2 flex items-center justify-around gap-1">
            <button onclick="openModal('decor-modal')" class="flex flex-col items-center gap-1 group">
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-violet-100 border-2 border-slate-900 flex items-center justify-center text-lg group-hover:scale-110 shadow-sm">🪑</div>
                <span class="text-[10px] sm:text-xs font-extrabold">Bày trí</span>
            </button>
            <button onclick="openModal('devices-modal')" class="flex flex-col items-center gap-1 group">
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-teal-100 border-2 border-slate-900 flex items-center justify-center text-lg group-hover:scale-110 shadow-sm">🤖</div>
                <span class="text-[10px] sm:text-xs font-extrabold">Thiết bị</span>
            </button>
            <button onclick="openModal('breed-modal')" class="flex flex-col items-center gap-1 group">
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-amber-100 border-2 border-slate-900 flex items-center justify-center text-lg group-hover:scale-110 shadow-sm">🐱</div>
                <span class="text-[10px] sm:text-xs font-extrabold">Đàn mèo</span>
            </button>
            <button onclick="openModal('couple-modal')" class="flex flex-col items-center gap-1 group">
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-pink-100 border-2 border-slate-900 flex items-center justify-center text-lg group-hover:scale-110 shadow-sm">💕</div>
                <span class="text-[10px] sm:text-xs font-extrabold">Ghép đôi</span>
            </button>
        </div>

